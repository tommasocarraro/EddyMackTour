generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String
  youtubeUrl  String
  thumbnail   String
  client      String?
  role        String?
  year        Int
  order       Int        @default(0)
  categories  Category[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
