DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Single admin account (no sign-up flow).
ADMIN_EMAIL="eddy@eddymack.tour"
# Generate with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('your-password', 10)).toString('base64'))"
# (base64-encoded because Next.js expands $ in plain .env values, which corrupts a raw bcrypt hash)
ADMIN_PASSWORD_HASH_BASE64=""

# Random 32+ char string used to sign the admin session cookie.
SESSION_SECRET="change-me-to-a-long-random-string"

# Thumbnail uploads go to Cloudinary (free tier: https://cloudinary.com) instead of
# local disk, so they survive on hosts with ephemeral/no persistent filesystems.
# Find these on your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: pre-fills a project's title & description from its YouTube link in the
# Studio form (via the YouTube Data API v3). Leave empty to skip this — the admin
# just fills those fields in by hand. Get a key at https://console.cloud.google.com
# (enable "YouTube Data API v3" on a project, then create an API key).
YOUTUBE_API_KEY=""

# Video files uploaded from the Studio are hosted on Bunny Stream (https://bunny.net/stream),
# which has no public page for a video: it only plays in the site's player. Create a
# Stream video library, then copy these from its "API" page. Without them the Studio
# still works with YouTube/Vimeo links, only the "upload a video file" option fails.
# Also add the site's domain (and localhost:3000 for dev, with the port) under the
# library's Security > Allowed domains, so the player can't be embedded anywhere else.
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
# The library's "CDN hostname", e.g. vz-1a2b3c4d-5e6.b-cdn.net (thumbnails are served from it).
BUNNY_STREAM_CDN_HOSTNAME=""
